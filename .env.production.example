# Production settings.
PUBLIC_BASE_URL=https://your-public-host.example
PORT=3000
DATA_DIR=/app/data
WEBHOOK_DELIVERY_RETENTION_DAYS=7

# Quo/OpenPhone API.
QUO_API_KEY=
QUO_WEBHOOK_KEY=
QUO_WEBHOOK_ID=
QUO_FROM=
QUO_TEST_TO=
SMS_DRY_RUN=false

# Optional first-bridge fallback. Usually leave blank once aliases/replies work.
BRIDGY_DEFAULT_WA_JID=

# Trust links shown on setup pages and /version.
BRIDGY_SOURCE_URL=https://github.com/ateesdalejr/bridgy
BRIDGY_TRUST_BASE_URL=https://bridgy.chat
BRIDGY_COMMIT_SHA=
