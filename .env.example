# Public URL used in setup links and webhooks.
# Local dry-run can use http://localhost:3000. Real SMS webhooks need HTTPS.
PUBLIC_BASE_URL=http://localhost:3000

# Bun server.
PORT=3000
DATA_DIR=./data
WEBHOOK_DELIVERY_RETENTION_DAYS=7

# Quo/OpenPhone API.
QUO_API_KEY=
QUO_WEBHOOK_KEY=
QUO_WEBHOOK_ID=
QUO_FROM=PNxxxxxxxx
QUO_TEST_TO=

# Defaults to true if Quo credentials are missing. Set to false in production.
SMS_DRY_RUN=true

# Optional first-bridge fallback. If set, a linked user can send plain SMS
# before any active WhatsApp chat exists.
BRIDGY_DEFAULT_WA_JID=

# Trust links shown on setup pages and /version.
BRIDGY_SOURCE_URL=https://github.com/ateesdalejr/bridgy
BRIDGY_TRUST_BASE_URL=https://bridgy.chat
BRIDGY_COMMIT_SHA=

# Optional: used by /setup/test for the Phase 2 setup-page smoke test.
# If omitted, the test page displays "test user" instead of a fake number.
BRIDGY_TEST_SMS_PHONE=
